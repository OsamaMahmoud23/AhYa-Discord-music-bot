# ==============================
#   AH_YA Discord Music Bot
#   Environment Configuration
# ==============================

# Discord Bot Token (Required)
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Discord Application/Client ID (Required for slash commands)
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Discord Guild ID (Optional - for guild-specific command deployment during testing)
# Leave empty for global command deployment
GUILD_ID=

# Spotify API Credentials (Required for Spotify links)
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID_HERE
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET_HERE

# Genius API Token (Required for Lyrics feature)
# Get from: https://genius.com/api-clients
GENIUS_API_TOKEN=YOUR_GENIUS_API_TOKEN_HERE

# Bot Settings
BOT_PREFIX=!
DEFAULT_VOLUME=50
MAX_QUEUE_SIZE=100
LEAVE_ON_EMPTY_COOLDOWN=30000
LEAVE_ON_FINISH_COOLDOWN=30000
